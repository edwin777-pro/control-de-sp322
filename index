<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control FarmBot - HiveMQ</title>
    <script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .card {
            background-color: #1e293b;
            border-radius: 16px;
            padding: 28px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            border: 1px solid #334155;
        }

        .header {
            text-align: center;
            margin-bottom: 24px;
        }

        .header h2 {
            font-size: 1.5rem;
            color: #f1f5f9;
            margin-bottom: 6px;
        }

        .status-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 0.9rem;
            color: #94a3b8;
            margin-bottom: 24px;
            padding: 8px;
            background-color: #0f172a;
            border-radius: 8px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #ef4444;
            transition: background-color 0.3s ease;
        }

        .status-dot.connected {
            background-color: #22c55e;
        }

        .status-dot.connecting {
            background-color: #eab308;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .btn {
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-on {
            background-color: #22c55e;
            color: #052e16;
        }

        .btn-on:hover:not(:disabled) {
            background-color: #16a34a;
        }

        .btn-off {
            background-color: #ef4444;
            color: #450a0a;
        }

        .btn-off:hover:not(:disabled) {
            background-color: #dc2626;
        }

        .log-box {
            margin-top: 24px;
            background-color: #020617;
            border: 1px solid #1e293b;
            border-radius: 8px;
            padding: 12px;
            font-family: monospace;
            font-size: 0.82rem;
            color: #38bdf8;
            height: 100px;
            overflow-y: auto;
        }
    </style>
</head>
<body>

    <div class="card">
        <div class="header">
            <h2>Control FarmBot</h2>
            <p style="font-size: 0.85rem; color: #64748b; margin-top: 4px;">HiveMQ Cloud WebSockets</p>
        </div>

        <div class="status-container">
            <div id="statusDot" class="status-dot connecting"></div>
            <span id="statusText">Conectando a HiveMQ...</span>
        </div>

        <div class="btn-group">
            <button id="btnOn" class="btn btn-on" onclick="enviarComando('1')" disabled>
                💡 ENCENDER SISTEMA
            </button>
            <button id="btnOff" class="btn btn-off" onclick="enviarComando('0')" disabled>
                🔌 APAGAR SISTEMA
            </button>
        </div>

        <div id="log" class="log-box">Iniciando conexión...<br></div>
    </div>

    <script>
        const options = {
            clientId: 'WebClient_' + Math.random().toString(16).substr(2, 8),
            username: 'sp32',
            password: '123456789',
            clean: true,
            connectTimeout: 4000,
            reconnectPeriod: 2000,
        };

        const host = 'wss://810eb95b7b3f456990ad8fce9280f402.s1.eu.hivemq.cloud:8884/mqtt';
        const topic = 'cnc/control';

        const statusDot = document.getElementById('statusDot');
        const statusText = document.getElementById('statusText');
        const btnOn = document.getElementById('btnOn');
        const btnOff = document.getElementById('btnOff');
        const log = document.getElementById('log');

        function addLog(msg) {
            log.innerHTML += msg + '<br>';
            log.scrollTop = log.scrollHeight;
        }

        const client = mqtt.connect(host, options);

        client.on('connect', () => {
            statusDot.className = 'status-dot connected';
            statusText.innerText = 'Conectado a HiveMQ';
            btnOn.disabled = false;
            btnOff.disabled = false;
            addLog('Conexión establecida.');
        });

        client.on('reconnect', () => {
            statusDot.className = 'status-dot connecting';
            statusText.innerText = 'Reconectando...';
            btnOn.disabled = true;
            btnOff.disabled = true;
            addLog('Reconectando...');
        });

        client.on('error', (err) => {
            statusDot.className = 'status-dot';
            statusText.innerText = 'Error de conexión';
            addLog('Error: ' + err.message);
        });

        function enviarComando(valor) {
            if (client.connected) {
                client.publish(topic, valor);
                addLog('Enviado: ' + valor);
            }
        }
    </script>
</body>
</html>
